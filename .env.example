# Copy this file to .env for local use. Never place real secrets in this file.
APP_NAME=Cloud Security Compliance and IAM Governance Automation
APP_ENV=development
LOG_LEVEL=INFO
CONFIG_FILE=config/default.yaml

# Placeholder cloud identifiers only. Authentication should use the provider's
# secure credential chain or a managed identity rather than values in source control.
AWS_REGION=us-east-1
AWS_PROFILE=your-local-profile-name
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/your-read-only-security-audit-role
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Generate distinct high-entropy values at deployment time. Store them in a
# secret manager; these placeholders are intentionally unusable.
API_READER_TOKEN=replace-with-reader-token
API_OPERATOR_TOKEN=replace-with-operator-token
API_REVIEWER_TOKEN=replace-with-independent-reviewer-token
CLOUD_PROVIDERS=aws
STORAGE_BACKEND=dynamodb
DYNAMODB_TABLE_NAME=cloud-security-governance-records
AZURE_STORAGE_ACCOUNT_URL=https://yourstorageaccount.blob.core.windows.net
AZURE_STORAGE_CONTAINER=governance-records
